{
    "name": "trivia-client",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run src && npm run typecheck",
        "host": "vite --host",
        "deploy": "npm run build && wrangler deploy",
        "deploy:check": "npm run build && wrangler deploy --dry-run"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/react-test-renderer": "^18.3.2",
        "@vitejs/plugin-react": "^6.3.0",
        "typescript": "^7.0.2",
        "react-test-renderer": "^18.3.1",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "wrangler": "^4.160.1"
    }
}