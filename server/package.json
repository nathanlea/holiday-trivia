{
    "name": "trivia-server",
    "version": "1.0.0",
    "private": true,
    "main": "dist/server/src/index.js",
    "type": "commonjs",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/server/src/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run && npm run typecheck",
        "host": "node dist/server/src/index.js"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^4.22.3",
        "helmet": "^8.3.0",
        "ws": "^8.22.2",
        "sequelize": "^6.37.8",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^24.19.2",
        "@types/ws": "^8.18.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}