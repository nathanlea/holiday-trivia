{
    "name": "trivia-server",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "type": "commonjs",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only --poll src/index.ts",
        "build": "tsc --project tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run && npm run typecheck"
    },
    "dependencies": {
        "@types/cors": "^2.8.19",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "helmet": "^7.0.0",
        "ws": "^8.14.2",
        "sequelize": "^6.35.1",
        "sqlite3": "^5.1.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.2",
        "@types/express": "^4.17.21",
        "@types/node": "^20.8.7",
        "@types/ws": "^8.5.10",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2",
        "vitest": "^1.6.0"
    }
}